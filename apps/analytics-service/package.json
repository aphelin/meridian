{
  "name": "analytics-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --dir test --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@meridian/contracts": "*",
    "@meridian/kernel": "*",
    "@meridian/nest-kit": "*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "@prisma/instrumentation": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
