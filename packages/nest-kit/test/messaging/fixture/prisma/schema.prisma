generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("KIT_FIXTURE_DATABASE_URL")
}

model Outbox {
  id            String    @id
  kind          String
  name          String
  aggregateType String?
  aggregateId   String?
  payload       Json
  correlationId String
  causationId   String?
  traceparent   String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  @@index([publishedAt, createdAt])
}

model Inbox {
  messageId   String
  consumer    String
  processedAt DateTime @default(now())
  @@id([messageId, consumer])
}

model DemoHandled {
  id            String   @id @default(cuid())
  consumer      String
  messageId     String
  correlationId String
  instanceId    String
  attempt       Int
  handledAt     DateTime @default(now())
  @@index([messageId])
}
