# Environment for the `apps` compose profile (containerised services + storefront).
# In-network hostnames of the core profile; loaded by every app container. Local defaults only, no real
# secrets. Override any key in infra/docker/apps.env.local (optional, git-ignored).
#
# Isolation from a host dev stack (`npm run dev:api` against the same core infra): the containers use
# their own database (meridian_docker; `migrate` creates it), messaging namespace (topics, queues and
# consumer groups prefixed `docker.`) and Redis key prefix. One schema is always paired with one
# namespace, so outbox relays and consumers never steal each other's rows or messages.
# Database URLs are set per service in compose.yml from MERIDIAN_APPS_DB (default meridian_docker).

LOG_LEVEL=info
# Chaos endpoints stay 404 when NODE_ENV=production.
CHAOS_ENABLED=true
CORS_ORIGINS=

# ---- service URLs (compose DNS) ----
IDENTITY_URL=http://identity-service:3001
CATALOG_URL=http://catalog-service:3012
INVENTORY_URL=http://inventory-service:3003
CHECKOUT_URL=http://checkout-service:3004
PAYMENT_URL=http://payment-service:3005
NOTIFICATION_URL=http://notification-service:3006
SEARCH_URL=http://search-worker:3007
ANALYTICS_URL=http://analytics-service:3008
PUBLIC_SITE_URL=http://localhost:3200

# ---- backing services ----
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=docker:
RABBIT_URL=amqp://guest:guest@rabbitmq:5672
RABBIT_RETRY_DELAYS_MS=5000,30000,120000
KAFKA_BROKERS=kafka:29092
KAFKA_RETRY_DELAYS_MS=500,2000,5000
MESSAGING_NAMESPACE=docker
OUTBOX_POLL_MS=500

# ---- auth (local-only values; >= 32 chars because NODE_ENV may be production) ----
JWT_SECRET=docker-local-jwt-secret-change-me-0123456789
ORDER_LINK_SECRET=docker-local-order-link-secret-change-me-0123
ADMIN_EMAIL=admin@meridian.local
ADMIN_PASSWORD=meridian-admin

# ---- email (Mailhog) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SANDBOX_HOSTS=
MAILHOG_API_URL=http://mailhog:8025
SUPPORT_EMAIL=support@meridian.local

# ---- object storage (SeaweedFS, S3 API). S3_PUBLIC_URL is what browsers load, so it uses the published host port. ----
S3_ENDPOINT=http://s3:9000
# Presigned links (invoice downloads, admin image uploads) are opened by the browser, so they are signed for the published port.
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=meridian
S3_SECRET_KEY=meridianminio
S3_BUCKET_MEDIA=meridian-media
S3_BUCKET_INVOICES=meridian-invoices
S3_PUBLIC_URL=http://localhost:9000/meridian-media

# ---- captcha (Cloudflare Turnstile test keys: always pass) ----
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_TIMEOUT_MS=3000

# ---- payments: Stripe test mode (live keys refuse to start); put the real test keys and the
# `stripe listen --forward-to localhost:13005/webhooks/stripe` secret in apps.env.local ----
# stripe | paddle | local; empty = stripe when STRIPE_SECRET_KEY is set, else paddle, else local
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Paddle sandbox: retained second adapter (Paddle does not allow physical goods)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# ---- observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---- graceful shutdown (compose stop_grace_period is 40s) ----
SHUTDOWN_DRAIN_MS=2000
SHUTDOWN_HOOK_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=25000
BREAKER_RESET_MS=10000

# ---- commerce ----
ORDER_HOLD_MINUTES=15
DEFAULT_STOCK_ON_HAND=8
INVOICE_LINK_SECONDS=300
PAYMENT_SUMMARY_TIMEOUT_MS=2000
S3_TIMEOUT_MS=5000

# ---- storefront BFF ----
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_LOOPBACK=false
