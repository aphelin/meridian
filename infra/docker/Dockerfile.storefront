# syntax=docker/dockerfile:1.7
# Storefront (Next.js standalone output), built from the repository root:
#   docker build -f infra/docker/Dockerfile.storefront -t meridian/storefront:local .
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so pass them as build args.
# Server-side settings (service URLs, JWT_SECRET, S3 ...) are read at runtime from the environment.
# next.config.ts loads the repository-root .env when present; .dockerignore keeps it out of the image.

ARG NODE_IMAGE=node:24.15.0-bookworm-slim

FROM ${NODE_IMAGE} AS base
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# ---- deps: storefront + @meridian/contracts (dev deps included for the build) ----
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/kernel/package.json packages/kernel/
COPY packages/nest-kit/package.json packages/nest-kit/
COPY apps/identity-service/package.json apps/identity-service/
COPY apps/catalog-service/package.json apps/catalog-service/
COPY apps/inventory-service/package.json apps/inventory-service/
COPY apps/checkout-service/package.json apps/checkout-service/
COPY apps/payment-service/package.json apps/payment-service/
COPY apps/notification-service/package.json apps/notification-service/
COPY apps/search-worker/package.json apps/search-worker/
COPY apps/analytics-service/package.json apps/analytics-service/
COPY apps/storefront/package.json apps/storefront/
RUN --mount=type=cache,target=/root/.npm \
    npm ci -w @meridian/contracts -w storefront

# ---- build ----
FROM deps AS build
COPY packages/contracts packages/contracts
RUN npm run build -w @meridian/contracts
COPY apps/storefront apps/storefront
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
ARG NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
ARG NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
ARG NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
# Evaluated by next.config.ts at build time (allowed remote image host for admin uploads).
ARG S3_PUBLIC_URL=
ARG BUILD_NODE_OPTIONS=--max-old-space-size=2048
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY} \
    NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=${NEXT_PUBLIC_PADDLE_CLIENT_TOKEN} \
    NEXT_PUBLIC_DEMO_ADMIN_EMAIL=${NEXT_PUBLIC_DEMO_ADMIN_EMAIL} \
    NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=${NEXT_PUBLIC_DEMO_ADMIN_PASSWORD} \
    S3_PUBLIC_URL=${S3_PUBLIC_URL}
RUN --mount=type=cache,target=/app/apps/storefront/.next/cache \
    NODE_ENV=production NODE_OPTIONS="${BUILD_NODE_OPTIONS}" npm run build -w storefront \
 && test -f apps/storefront/.next/standalone/apps/storefront/server.js

# ---- runtime ----
FROM base AS runtime
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0 SERVICE_NAME=storefront
# Standalone output keeps the monorepo layout: /app/apps/storefront/server.js + traced node_modules.
COPY --from=build /app/apps/storefront/.next/standalone /app
# .next must be writable by the app user: Next writes ISR/segment output and the image cache there at runtime.
COPY --from=build --chown=node:node /app/apps/storefront/.next/standalone/apps/storefront/.next /app/apps/storefront/.next
COPY --from=build --chown=node:node /app/apps/storefront/.next/static /app/apps/storefront/.next/static
COPY --from=build /app/apps/storefront/public /app/apps/storefront/public
WORKDIR /app/apps/storefront
# COPY --chown leaves an existing target directory root-owned; hand .next itself (and the cache dir) to node.
RUN chown node:node .next && install -d -o node -g node .next/cache
USER node
EXPOSE 3100
STOPSIGNAL SIGTERM
# The storefront has no health route (Helm uses a TCP probe); check that the port accepts connections.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "require('net').connect(+process.env.PORT,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]
CMD ["node", "server.js"]
