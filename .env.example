# Meridian local environment. Copy to .env (or run `node scripts/sync-env.mjs`, which only
# appends missing keys). Values target the compose stack in infra/docker/compose.yml.
# Never commit real secrets; everything here is a local or sandbox default.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Enables /admin/chaos fault injection (never in production).
CHAOS_ENABLED=true
# Comma list of browser origins allowed to call services directly (the BFF does not need it).
CORS_ORIGINS=

# ---- Service URLs (contract ports; 3000 and 3002 belong to other projects) ----
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3012
INVENTORY_URL=http://localhost:3003
CHECKOUT_URL=http://localhost:3004
PAYMENT_URL=http://localhost:3005
NOTIFICATION_URL=http://localhost:3006
SEARCH_URL=http://localhost:3007
ANALYTICS_URL=http://localhost:3008
PUBLIC_SITE_URL=http://localhost:3100

# ---- Postgres (one schema per service, compose port 5434) ------------------
IDENTITY_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=identity
CATALOG_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=catalog
INVENTORY_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=inventory
CHECKOUT_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=checkout
PAYMENT_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=payment
NOTIFICATION_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=notification
SEARCH_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=search
ANALYTICS_DATABASE_URL=postgresql://meridian:meridian@localhost:5434/meridian?schema=analytics

# ---- Redis (cache, rate limits, chaos rules) --------------------------------
REDIS_URL=redis://localhost:6380
# Key prefix for isolation (tests use t-<leaf>:); empty in dev.
REDIS_KEY_PREFIX=

# ---- Messaging --------------------------------------------------------------
# RabbitMQ carries commands; retry tiers in ms before the DLQ.
RABBIT_URL=amqp://guest:guest@localhost:5672
RABBIT_RETRY_DELAYS_MS=5000,30000,120000
# Kafka carries domain events; in-process retry delays in ms before the group DLT.
KAFKA_BROKERS=localhost:9092
KAFKA_RETRY_DELAYS_MS=500,2000,5000
# Prefix for topics, queues and consumer groups (tests use t-<leaf>); empty in dev.
MESSAGING_NAMESPACE=
OUTBOX_POLL_MS=500

# ---- Auth and secrets (supply your own; empty = dev-only fallbacks) ---------
# Required (>= 32 chars) outside development/test.
JWT_SECRET=
# HMAC key for guest order links; falls back to a key derived from JWT_SECRET in dev.
ORDER_LINK_SECRET=
ADMIN_EMAIL=admin@meridian.local
ADMIN_PASSWORD=meridian-admin

# ---- Email (Mailhog sandbox only) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# Extra hostnames accepted by the sandbox SMTP guard (comma list).
SMTP_SANDBOX_HOSTS=
MAILHOG_API_URL=http://localhost:8025
SUPPORT_EMAIL=support@meridian.local

# ---- Object storage (MinIO, S3 API) -----------------------------------------
S3_ENDPOINT=http://localhost:9000
# Host browsers use for presigned links (invoice downloads, image uploads). Defaults to S3_ENDPOINT; set it when the services reach MinIO under another name (Docker: http://localhost:9000).
# S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=meridian
S3_SECRET_KEY=meridianminio
S3_BUCKET_MEDIA=meridian-media
S3_BUCKET_INVOICES=meridian-invoices
S3_PUBLIC_URL=http://localhost:9000/meridian-media

# ---- Captcha (Cloudflare Turnstile official test keys: always pass) ---------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_TIMEOUT_MS=3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- Payments: Stripe test mode (live keys refuse to start) -----------------
# stripe | paddle | local. Empty = stripe when STRIPE_SECRET_KEY is set, else paddle when configured, else local.
PAYMENT_PROVIDER=
# Test secret key from the Stripe Dashboard (test mode): sk_test_... or a restricted rk_test_... Never a live key.
STRIPE_SECRET_KEY=
# Test publishable key, pk_test_... (payment-service hands it to the Payment Element with each intent)
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret, whsec_... In development: `npm run stripe:secret -w payment-service` stores the
# `stripe listen` secret here; `npm run stripe:listen -w payment-service` forwards events to :3005/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# ---- Payments: Paddle sandbox (retained second adapter; Paddle does not allow physical goods) ----
PADDLE_ENV=sandbox
# Sandbox API key, starts with pdl_sdbx_
PADDLE_API_KEY=
# Sandbox client token, starts with test_
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# ---- Observability ----------------------------------------------------------
# Jaeger OTLP HTTP; leave empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Resilience and graceful shutdown ---------------------------------------
# Readiness turns 503 first, then the service waits DRAIN before closing HTTP.
SHUTDOWN_DRAIN_MS=2000
SHUTDOWN_HOOK_TIMEOUT_MS=10000
# Hard cap for the whole shutdown sequence (exit 1 when exceeded).
SHUTDOWN_TIMEOUT_MS=25000
BREAKER_RESET_MS=10000

# ---- Commerce defaults ------------------------------------------------------
ORDER_HOLD_MINUTES=15
DEFAULT_STOCK_ON_HAND=8

# checkout-service operations (optional; defaults shown)
INVOICE_LINK_SECONDS=300
PAYMENT_SUMMARY_TIMEOUT_MS=2000
S3_TIMEOUT_MS=5000

# storefront: demo admin hint on the sign-in form (development only; leave unset in production builds)
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

# storefront BFF: number of trusted reverse-proxy hops appended to x-forwarded-for (0 = none; set 1 behind one proxy)
TRUSTED_PROXY_HOPS=0
# services: also count the `ip` rate-limit dimension for loopback callers (off locally, where the BFF calls from 127.0.0.1)
RATE_LIMIT_LOOPBACK=false
